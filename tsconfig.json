{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"],
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "types": ["node", "vscode"], "noEmit": true
  },
  "include": ["src", "tests", "scripts/*.ts"]
}
